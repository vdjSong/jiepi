<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="更多"
        android:textColor="@color/jp_soft_white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <!-- 定时关闭：仅图标 + 当前设定小字（最小化展示） -->
        <LinearLayout
            android:id="@+id/btn_more_timer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_speed_option"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_play_timer"
                android:tint="@color/jp_unselected_text"
                android:contentDescription="定时关闭" />

            <TextView
                android:id="@+id/timer_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="关"
                android:textColor="@color/jp_sub_text"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 循环模式：仅图标（图标即当前模式，四图标切换逻辑不变） -->
        <LinearLayout
            android:id="@+id/btn_more_loop"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_speed_option"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/loop_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_play_repeat"
                android:tint="@color/jp_unselected_text"
                android:contentDescription="循环模式" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
