<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".ui.music.MusicFragment">

    <!-- 分类栏：歌曲 / 歌单 / 文件夹，图标+文字，无框 -->
    <LinearLayout
        android:id="@+id/category_bar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 歌曲 tab -->
        <LinearLayout
            android:id="@+id/tab_song"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/icon_song"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_music_music"
                android:scaleType="center"
                android:tint="#888888"
                android:contentDescription="歌曲" />

            <TextView
                android:id="@+id/cat_song"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="歌曲"
                android:textColor="#888888"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 歌单 tab -->
        <LinearLayout
            android:id="@+id/tab_playlist"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/icon_playlist"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_music_playlist"
                android:scaleType="center"
                android:tint="#888888"
                android:contentDescription="歌单" />

            <TextView
                android:id="@+id/cat_playlist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="歌单"
                android:textColor="#888888"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 文件夹 tab -->
        <LinearLayout
            android:id="@+id/tab_folder"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/icon_folder"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_music_folder"
                android:scaleType="center"
                android:tint="#888888"
                android:contentDescription="文件夹" />

            <TextView
                android:id="@+id/cat_folder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="文件夹"
                android:textColor="#888888"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#222222"
        app:layout_constraintTop_toBottomOf="@id/category_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 歌曲列表：只在"歌曲"分类显示；外层 SwipeRefreshLayout 提供下拉刷新（手动激活一次扫描），全宽让圈居中 -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/song_swipe"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ListView
            android:id="@+id/song_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:divider="@null"
            android:paddingEnd="28dp"
            android:clipToPadding="false" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- 右侧 A-Z 索引条 -->
    <LinearLayout
        android:id="@+id/index_bar"
        android:layout_width="28dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="@id/divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 空提示：没有歌曲时显示（与歌单/文件夹空态同款：图标 + 文字，贴列表区域顶部往下） -->
    <LinearLayout
        android:id="@+id/song_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="80dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_music_music"
            android:tint="#CCCCCC"
            android:contentDescription="歌曲" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="还没有歌曲"
            android:textColor="#888888"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- 歌单页：顶部一排按钮（固定）+ 下面滚动列表 -->
    <LinearLayout
        android:id="@+id/playlist_page"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 顶部按钮栏：新建歌单 + 删除歌单，平分宽度 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_new_playlist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="新建歌单"
                android:textAllCaps="false"
                android:textColor="@color/jp_on_blue"
                android:textSize="15sp"
                app:backgroundTint="@color/jp_primary_blue"
                app:cornerRadius="22dp"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="18dp"
                app:iconTint="@color/jp_on_blue" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete_playlist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="删除歌单"
                android:textAllCaps="false"
                android:textColor="@color/jp_on_blue"
                android:textSize="15sp"
                app:backgroundTint="#FF9A8A"
                app:cornerRadius="22dp"
                app:icon="@drawable/ic_delete"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="18dp"
                app:iconTint="@color/jp_on_blue" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- 滚动区域：歌单行 + 空提示 -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 歌单行容器：每行由代码添加 -->
                <LinearLayout
                    android:id="@+id/playlist_list_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- 空提示：没有歌单时显示 -->
                <LinearLayout
                    android:id="@+id/playlist_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="80dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_music_playlist"
                        android:tint="#CCCCCC"
                        android:contentDescription="歌单" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="还没有歌单"
                        android:textColor="#888888"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- 文件夹页：顶部一排按钮（固定）+ 下面滚动列表 -->
    <LinearLayout
        android:id="@+id/folder_page"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 顶部按钮栏：添加文件夹 + 删除文件夹，平分宽度 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_folder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="添加文件夹"
                android:textAllCaps="false"
                android:textColor="@color/jp_on_blue"
                android:textSize="15sp"
                app:backgroundTint="@color/jp_primary_blue"
                app:cornerRadius="22dp"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="18dp"
                app:iconTint="@color/jp_on_blue" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete_folder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="删除文件夹"
                android:textAllCaps="false"
                android:textColor="@color/jp_on_blue"
                android:textSize="15sp"
                app:backgroundTint="#FF9A8A"
                app:cornerRadius="22dp"
                app:icon="@drawable/ic_delete"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="18dp"
                app:iconTint="@color/jp_on_blue" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- 滚动区域：文件夹行 + 空提示 -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 文件夹行容器：每行由代码添加 -->
                <LinearLayout
                    android:id="@+id/folder_list_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- 空提示：没有文件夹时显示 -->
                <LinearLayout
                    android:id="@+id/folder_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="80dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_music_folder"
                        android:tint="#CCCCCC"
                        android:contentDescription="文件夹" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="还没有添加音乐文件夹"
                        android:textColor="#888888"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
