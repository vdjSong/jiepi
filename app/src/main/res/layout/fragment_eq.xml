                        android:text="125"
                        android:textColor="#888888"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- 250 -->
                <LinearLayout
                    android:layout_width="70dp"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/eq_val_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:text="0"
                        android:textColor="#CCCCCC"
                        android:textSize="13sp" />

                    <com.jiepi.player.ui.NeonSlider
                        android:id="@+id/eq_band_4"
                        android:layout_width="70dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:max="48"
                        android:progress="24" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:text="250"
                        android:textColor="#888888"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- 500 -->
                <LinearLayout
                    android:layout_width="70dp"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/eq_val_5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:text="0"
                        android:textColor="#CCCCCC"
                        android:textSize="13sp" />

                    <com.jiepi.player.ui.NeonSlider
                        android:id="@+id/eq_band_5"
                        android:layout_width="70dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:max="48"
                        android:progress="24" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:text="500"
                        android:textColor="#888888"
