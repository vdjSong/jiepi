                    <com.jiepi.player.ui.NeonSlider
                        android:id="@+id/eq_band_10"
                        android:layout_width="70dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:max="48"
                        android:progress="24" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
