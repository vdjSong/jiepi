<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 顶栏：返回 + 标题 -->
    <LinearLayout
        android:id="@+id/eq_top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_eq_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_play_back"
            android:tint="@color/jp_soft_white"
            android:contentDescription="返回" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingEnd="44dp"
            android:text="EQ 音效"
            android:textColor="@color/jp_soft_white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <com.jiepi.player.ui.play.EqCurveView
        android:id="@+id/eq_curve"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintHeight_default="spread"
        app:layout_constraintHeight_max="96dp"
        app:layout_constraintHeight_min="56dp"
        app:layout_constraintBottom_toTopOf="@id/eq_scroll_frame"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/eq_top_bar" />

    <!-- 滑动块：控制下方十频段调节区左右移动；外圈圆角长条框定位轨道（系统轨道色不可见），轨道贴框上半部不挡下方文字 -->
    <FrameLayout
        android:id="@+id/eq_scroll_frame"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toTopOf="@id/eq_bands_viewport"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/eq_curve">

        <com.jiepi.player.ui.NeonSlider
            android:id="@+id/eq_scroll_seek"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_gravity="center_vertical"
            android:max="100"
            android:progress="0" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/eq_bands_viewport"
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:clipChildren="true"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/eq_effects_area"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/eq_scroll_frame">

        <LinearLayout
            android:id="@+id/eq_bands_content"
            android:layout_width="700dp"
            android:layout_height="match_parent"
            android:orientation="horizontal">

                <!-- 32 -->
                <LinearLayout
                    android:layout_width="70dp"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/eq_val_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:text="0"
                        android:textColor="#CCCCCC"
                        android:textSize="13sp" />

                    <com.jiepi.player.ui.NeonSlider
                        android:id="@+id/eq_band_1"
                        android:layout_width="70dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:max="48"
                        android:progress="24" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:text="32"
                        android:textColor="#888888"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- 64 -->
