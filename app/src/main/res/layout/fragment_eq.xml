        </LinearLayout>
    </FrameLayout>

    <!-- 音效调节：6 个效果滑动条统一规格（名称/滑条/百分比同列对齐） -->
    <LinearLayout
        android:id="@+id/eq_effects_area"
        android:layout_width="0dp"
        android:layout_height="264dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="0dp"
        app:layout_constraintBottom_toTopOf="@id/eq_bottom_spacer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/eq_bands_viewport">

        <!-- 动态推进 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="动态推进"
                android:textColor="#CCCCCC"
                android:textSize="13sp" />

            <com.jiepi.player.ui.NeonSlider
                android:id="@+id/eq_effect_dynamic"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="12dp"
                android:max="100"
                android:progress="0" />

            <TextView
                android:id="@+id/eq_effect_dynamic_val"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1"
                android:text="0%"
                android:textColor="#CCCCCC"
                android:textSize="13sp" />
        </LinearLayout>
        <!-- 高保真 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="超高保真"
                android:textColor="#CCCCCC"
                android:textSize="13sp" />

            <com.jiepi.player.ui.NeonSlider
                android:id="@+id/eq_effect_hifi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="12dp"
                android:max="100"
                android:progress="0" />

            <TextView
                android:id="@+id/eq_effect_hifi_val"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1"
                android:text="0%"
                android:textColor="#CCCCCC"
                android:textSize="13sp" />
        </LinearLayout>
        <!-- 高音加强 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="高音增强"
                android:textColor="#CCCCCC"
                android:textSize="13sp" />

            <com.jiepi.player.ui.NeonSlider
                android:id="@+id/eq_effect_high"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="12dp"
                android:max="100"
                android:progress="0" />

            <TextView
                android:id="@+id/eq_effect_high_val"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1"
                android:text="0%"
                android:textColor="#CCCCCC"
                android:textSize="13sp" />
        </LinearLayout>
        <!-- 低音加强 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="低音增强"
                android:textColor="#CCCCCC"
                android:textSize="13sp" />

            <com.jiepi.player.ui.NeonSlider
                android:id="@+id/eq_effect_low"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="12dp"
                android:max="100"
                android:progress="0" />

            <TextView
                android:id="@+id/eq_effect_low_val"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1"
                android:text="0%"
                android:textColor="#CCCCCC"
                android:textSize="13sp" />
        </LinearLayout>
        <!-- 环绕 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="环绕"
                android:textColor="#CCCCCC"
                android:textSize="13sp" />

            <com.jiepi.player.ui.NeonSlider
                android:id="@+id/eq_effect_surround"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="12dp"
                android:max="100"
                android:progress="0" />

            <TextView
                android:id="@+id/eq_effect_surround_val"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1"
                android:text="0%"
                android:textColor="#CCCCCC"
                android:textSize="13sp" />
        </LinearLayout>
        <!-- 混响 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="混响"
                android:textColor="#CCCCCC"
                android:textSize="13sp" />

            <com.jiepi.player.ui.NeonSlider
                android:id="@+id/eq_reverb_seek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="12dp"
                android:max="100"
                android:progress="0" />

            <TextView
                android:id="@+id/eq_reverb_val"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1"
                android:text="0%"
                android:textColor="#CCCCCC"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/eq_bottom_spacer"
        android:layout_width="0dp"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/eq_effects_area" />
</androidx.constraintlayout.widget.ConstraintLayout>
