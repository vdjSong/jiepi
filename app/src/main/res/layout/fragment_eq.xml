<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <!-- 顶栏：返回 + 标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="12dp">

        <ImageView
            android:id="@+id/btn_eq_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_play_back"
            android:tint="@color/jp_soft_white"
            android:contentDescription="返回" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingEnd="44dp"
            android:text="EQ 音效"
            android:textColor="@color/jp_soft_white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 曲线窗口：固定一屏完整显示 10 个频段线条，不随频段区滚动 -->
    <com.jiepi.player.ui.play.EqCurveView
        android:id="@+id/eq_curve"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="6dp" />

    <!-- 滑动块：控制下方十频段调节区左右移动；外圈圆角长条框定位轨道（系统轨道色不可见），轨道贴框上半部不挡下方文字 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="2dp">

        <com.jiepi.player.ui.NeonSlider
            android:id="@+id/eq_scroll_seek"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:max="100"
            android:progress="0" />
    </FrameLayout>

    <!-- 十频段调节区：裁剪视口内整体平移，仅由上方滑动块控制左右（本身不可横滑） -->
    <FrameLayout
        android:id="@+id/eq_bands_viewport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="true"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/eq_bands_content"
            android:layout_width="700dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

                <!-- 32 -->
                <LinearLayout
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/eq_val_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="0"
                        android:textColor="#CCCCCC"
                        android:textSize="13sp" />

                    <FrameLayout
                        android:layout_width="70dp"
                        android:layout_height="150dp">

                        <com.jiepi.player.ui.NeonSlider
                            android:id="@+id/eq_band_1"
                            android:layout_width="150dp"
                            android:layout_height="70dp"
                            android:layout_gravity="center"
                            android:max="48"
                            android:progress="24"
                            android:rotation="270" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="32"
                        android:textColor="#888888"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- 64 -->
                <LinearLayout
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
