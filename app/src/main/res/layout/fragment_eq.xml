                        android:textSize="13sp" />

                    <com.jiepi.player.ui.NeonSlider
                        android:id="@+id/eq_band_7"
                        android:layout_width="70dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:max="48"
