<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_music">

    <fragment
        android:id="@+id/navigation_music"
        android:name="com.jiepi.player.ui.music.MusicFragment"
        android:label="@string/title_music"
        tools:layout="@layout/fragment_music" />

    <fragment
        android:id="@+id/navigation_play"
        android:name="com.jiepi.player.ui.play.PlayFragment"
        android:label="@string/title_play"
        tools:layout="@layout/fragment_play">

        <!-- 详情页 → EQ 独立页 -->
        <action
            android:id="@+id/action_play_to_eq"
            app:destination="@id/navigation_eq" />
    </fragment>

    <fragment
        android:id="@+id/navigation_more"
        android:name="com.jiepi.player.ui.more.MoreFragment"
        android:label="@string/title_more"
        tools:layout="@layout/fragment_more">

        <action
            android:id="@+id/action_more_to_settings"
            app:destination="@id/navigation_settings" />
        <action
            android:id="@+id/action_more_to_about"
            app:destination="@id/navigation_about" />
        <action
            android:id="@+id/action_more_to_recycle_bin"
            app:destination="@id/navigation_recycle_bin" />
        <action
            android:id="@+id/action_more_to_license"
            app:destination="@id/navigation_license" />
    </fragment>

    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.jiepi.player.ui.more.SettingsFragment"
        android:label="软件设置"
        tools:layout="@layout/fragment_settings">

        <action
            android:id="@+id/action_settings_to_recycle_bin"
            app:destination="@id/navigation_recycle_bin" />
    </fragment>

    <fragment
        android:id="@+id/navigation_about"
        android:name="com.jiepi.player.ui.more.AboutFragment"
        android:label="关于"
        tools:layout="@layout/fragment_about" />

    <fragment
        android:id="@+id/navigation_recycle_bin"
        android:name="com.jiepi.player.ui.more.RecycleBinFragment"
        android:label="回收站"
        tools:layout="@layout/fragment_recycle_bin" />

    <fragment
        android:id="@+id/navigation_license"
        android:name="com.jiepi.player.ui.more.LicenseFragment"
        android:label="开源声明"
        tools:layout="@layout/fragment_license" />

    <fragment
        android:id="@+id/navigation_eq"
        android:name="com.jiepi.player.ui.play.EqFragment"
        android:label="EQ 音效"
        tools:layout="@layout/fragment_eq" />
</navigation>
